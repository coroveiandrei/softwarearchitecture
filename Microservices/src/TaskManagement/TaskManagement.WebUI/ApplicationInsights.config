<?xml version="1.0" encoding="utf-8"?>
<ApplicationInsights xmlns="http://schemas.microsoft.com/ApplicationInsights/2013/Settings">
	<InstrumentationKey>985d3b30-4b1c-4814-b040-02f471c8bbca</InstrumentationKey>

	<TelemetryInitializers>
		<!-- Add any telemetry initializers here -->
	</TelemetryInitializers>

	<TelemetryModules>
		<!-- Enables tracking of all request telemetry -->
		<Add Type="Microsoft.ApplicationInsights.Web.RequestTrackingTelemetryModule, Microsoft.AI.Web"/>

		<!-- Tracks failed requests/exceptions -->
		<Add Type="Microsoft.ApplicationInsights.Web.ExceptionTrackingTelemetryModule, Microsoft.AI.Web"/>

		<!-- Tracks dependencies (such as HTTP requests to other services) -->
		<Add Type="Microsoft.ApplicationInsights.DependencyCollector.DependencyTrackingTelemetryModule, Microsoft.AI.DependencyCollector"/>

		<!-- Tracks performance counters (available only for specific hosting environments) -->
		<Add Type="Microsoft.ApplicationInsights.WindowsServer.TelemetryChannel.PerfCounterCollectorModule, Microsoft.AI.PerfCounterCollector"/>

		<!-- Enables page view tracking (for client-side applications) -->
		<Add Type="Microsoft.ApplicationInsights.Web.PageViewTelemetryModule, Microsoft.AI.Web"/>

		<!-- Enables heartbeat monitoring (tracks application status) -->
		<Add Type="Microsoft.ApplicationInsights.WindowsServer.Heartbeat.HeartbeatProvider, Microsoft.AI.WindowsServer"/>

		<!-- Enables logging telemetry (for custom traces and logs) -->
		<Add Type="Microsoft.ApplicationInsights.WindowsServer.TelemetryChannel.DiagnosticTelemetryModule, Microsoft.AI.WindowsServer"/>

		<!-- Enables Azure role instance tracking (useful for distributed systems) -->
		<Add Type="Microsoft.ApplicationInsights.WindowsServer.AzureInstanceMetadataTelemetryModule, Microsoft.AI.WindowsServer"/>

	</TelemetryModules>

	<TelemetryProcessors>
		<!-- Add telemetry processors to filter or enrich telemetry -->
	</TelemetryProcessors>

	<TelemetryChannel>
		<!-- Configures telemetry channel for sending data to Application Insights -->
		<DeveloperMode>false</DeveloperMode>
		<EndpointAddress>https://dc.services.visualstudio.com/v2/track</EndpointAddress>
	</TelemetryChannel>
</ApplicationInsights>
