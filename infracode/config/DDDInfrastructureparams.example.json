{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageAccounts": {
      "value": [
        {
          "name": "changemestorageaccount",
          "kind": "StorageV2",
          "sku": {
            "name": "Standard_LRS",
            "tier": "Standard"
          },
          "properties": {
            "publicNetworkAccess": "Enabled"
          }
        }
      ]
    },
    "sqlServers": {
      "value": [
        {
          "name": "change-me-sql-server",
          "database": "change-me-database",
          "username": "change-me-admin",
          "password": "CHANGE_ME",
          "publicNetworkAccess": "Enabled"
        }
      ]
    },
    "serviceBuses": {
      "value": [
        {
          "name": "change-me-service-bus",
          "sku": "Standard"
        }
      ]
    }
  }
}
